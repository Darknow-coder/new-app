rules_version = '2';
// Marbl leaderboard. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    match /players/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['a', 'b', 'n', 'levels', 'stars', 'score', 'updated'])
        && request.resource.data.a is int && request.resource.data.a >= 0 && request.resource.data.a < 24
        && request.resource.data.b is int && request.resource.data.b >= 0 && request.resource.data.b < 24
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 100
        && request.resource.data.levels is int && request.resource.data.levels >= 0 && request.resource.data.levels <= 100000
        && request.resource.data.stars is int && request.resource.data.stars >= 0
        && request.resource.data.stars <= request.resource.data.levels * 3
        && request.resource.data.score == request.resource.data.levels * 1000 + request.resource.data.stars
        && request.resource.data.updated == request.time
        // at most one write every 5 seconds per player
        && (resource == null || request.time > resource.data.updated + duration.value(5, 's'));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Cloud saves. The document id is the player's secret 12-character recovery code:
    // documents can be fetched by code but never listed, so a code cannot be guessed.
    match /saves/{code} {
      allow get: if request.auth != null && code.matches('^[2-9A-HJKMNP-Z]{12}$');
      allow list: if false;
      allow delete: if request.auth != null && code.matches('^[2-9A-HJKMNP-Z]{12}$');
      allow create, update: if request.auth != null
        && code.matches('^[2-9A-HJKMNP-Z]{12}$')
        && request.resource.data.keys().hasOnly(['v', 'data', 'levels', 'updated'])
        && request.resource.data.v is int
        && request.resource.data.data is string && request.resource.data.data.size() < 400000
        && request.resource.data.levels is int && request.resource.data.levels >= 0 && request.resource.data.levels <= 100000
        && request.resource.data.updated == request.time
        // at most one backup every 20 seconds per code
        && (resource == null || request.time > resource.data.updated + duration.value(20, 's'));
    }
    // Anonymous play counters, one document per day (fields like s216 = starts of level 216).
    match /metrics/{day} {
      allow read: if true;
      allow create, update: if request.auth != null
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.size() < 3000;
    }
    // Player feedback: anyone signed in (anonymously) can send; nobody can read it from the game.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['rating', 'text', 'levels', 'lang', 'version', 'created'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.levels is int && request.resource.data.levels >= 0 && request.resource.data.levels <= 100000
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.created == request.time;
    }
  }
}
